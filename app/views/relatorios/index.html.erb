<h1>Relatórios</h1>

<% if @formularios.empty? %>
  <p>Não há formulários cadastrados.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Formulário</th>
        <th>Respostas</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @formularios.each do |formulario| %>
        <tr>
          <td><%= formulario.title %></td>
          <td><%= formulario.respostas.size %></td>
          <td><%= link_to "Ver relatório", relatorio_path(formulario) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
