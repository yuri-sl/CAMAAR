<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "header", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "gerenciamento", "data-turbo-track": "reload" %>
<% end %>

<%= render "shared/header", title: "Templates de Formulário" %>

<div class="gerenciamento-page">
  <aside class="sidebar">
    <%= link_to "Avaliações", avaliacoes_path, class: "sidebar-item" %>
    <%= link_to "Gerenciamento", gerenciamento_path, class: "sidebar-item active" %>
  </aside>

  <main class="content">
    <% if notice %>
      <p class="flash-notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="flash-alert"><%= alert %></p>
    <% end %>

    <section class="formulario-panel" style="width: min(900px, 100%);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="margin: 0;">Templates Salvos</h2>
        <%= link_to "Novo Template", new_template_formulario_path, class: "btn btn--primary", style: "width: auto; padding: 10px 20px;" %>
      </div>

      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 2px solid var(--gp-line);">
            <th style="padding: 12px 8px; color: var(--gp-ink-soft);">Nome do Template</th>
            <th style="padding: 12px 8px; color: var(--gp-ink-soft); width: 250px;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @template_formularios.each do |template| %>
            <tr style="border-bottom: 1px solid var(--gp-line);">
              <td style="padding: 14px 8px;"><%= template.nome_template %></td>
              <td style="padding: 14px 8px; display: flex; gap: 8px;">
                <%= link_to "Ver", template_formulario_path(template), class: "btn btn--primary", style: "width: auto; padding: 6px 12px; font-size: 0.85rem;" %>
                <%= link_to "Editar", edit_template_formulario_path(template), class: "btn btn--primary", style: "width: auto; padding: 6px 12px; font-size: 0.85rem;" %>
                <%= button_to "Excluir", template_formulario_path(template), method: :delete, form: { style: 'margin: 0;' }, class: "btn btn--danger", style: "width: auto; padding: 6px 12px; font-size: 0.85rem;", data: { turbo_confirm: "Tem certeza que deseja excluir este template?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </main>
</div>