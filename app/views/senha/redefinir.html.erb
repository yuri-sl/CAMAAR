<div class="main-page">
<div class="redefinir-container">
  <h1>REDEFINIÇÃO DE SENHA</h1>
  <%= form_with url: senha_redefinir_path, method: :post, class: "login-form" do |form| %>

    <div class="form-group">
      <%= form.password_field :password, placeholder: "Digite sua senha atual" %>
    </div>

    <div class="form-group">
      <%= form.password_field :new_password_1, placeholder: "Digite uma nova senha" %>
    </div>

    <div class="form-group">
      <%= form.password_field :new_password_2, placeholder: "Digite novamente a nova senha" %>
    </div>

    <%= form.submit "Redefinir", class: "login-button" %>
  <% end %>
</div>
</div>
